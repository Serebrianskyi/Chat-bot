# Copy to .env and fill in:  cp .env.example .env
# NEVER commit .env (standing gate S4).
#
# Keep every comment on its own line. python-dotenv does NOT strip trailing comments, so
# `CHANNEL_ID=   # some note` is read as the literal value "# some note".

# --- Required from Phase 0 ---

# @BotFather token. Use the TEST bot here, never production (CLAUDE.md rule 4).
BOT_TOKEN=

# Comma-separated Telegram user ids allowed into /admin, e.g. 111111111,222222222
# Get yours by messaging @userinfobot.
ADMIN_IDS=

# The private channel the bot administrates, e.g. -1001234567890
# Not needed until Phase 3 — Phase 1 never reads it, so you can leave it blank for now.
# If you do set it, it must be a numeric chat id or an @username.
CHANNEL_ID=

# --- Database ---

# Local SQLite file. Leave as-is unless this project ever moves to a host.
DATABASE_URL=sqlite+aiosqlite:///./chatbot.db

# --- Subscription pricing (Phase 2A) ---

# Regular monthly price for a new joiner. Per-user prices live in the price_rules table.
SUBSCRIPTION_PRICE=
SUBSCRIPTION_CURRENCY=UAH
SUBSCRIPTION_PERIOD_DAYS=30

# Days after the due date before an admin is alerted about a missing payment.
SUBSCRIPTION_GRACE_DAYS=3

# Remove members from the channel once their access has ended and grace has run out.
# Leave this false until a real payment has been confirmed end to end (gate G3.8): removing
# somebody who HAS paid is the most expensive mistake this bot can make, and payment detection
# has been wrong before. With it false the daily job reports who would be removed and does
# nothing, which is how you check the list first:  python -m scripts.run_jobs lapsed
REMOVAL_ENABLED=false

# When the free first period ends, for everyone who qualifies for one.
#
# One date doing two jobs: a qualifying member is free until this moment, and anyone starting the
# bot after it gets no free period and is billed monthly from the start. That is what "free until
# the end of the month" means — otherwise each person would get their own 30-day window and the
# club would be billing people on 30 different dates forever.
#
# Include the offset. Without one it is read as UTC, which is two hours early in Kyiv winter.
FREE_PERIOD_UNTIL=2026-11-01T00:00:00+02:00

# --- WayForPay (Phase 2A) ---
# Merchant login and Secret Key from the WayForPay dashboard. Never commit real values.

WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_DOMAIN=
WAYFORPAY_SECRET_KEY=

# --- Run mode ---

# polling (development) or webhook (production).
#
# webhook is what makes automatic renewals possible: WayForPay delivers a payment token to
# serviceUrl and nowhere else, so `CHARGE` can never fire without this endpoint. It also makes
# confirmation immediate instead of a two-minute poll. See docs/telegram-bot-payments-design.md
# §1a. In webhook mode BASE_URL and WEBHOOK_SECRET are both required and the bot refuses to
# start without them.
MODE=polling

# --- Webhook mode (Phase 4) ---

# The public HTTPS address of this service, no trailing path — e.g.
# https://your-service.up.railway.app. Telegram and WayForPay both post to it.
BASE_URL=

# Any long random string. Telegram sends it back in a header on every update; without it anyone
# who knows the URL could forge an update, including one impersonating an admin (G4.3).
WEBHOOK_SECRET=

# The port to listen on. The platform sets this — Railway does — so leave it unset there.
PORT=8000

# Unused: /jobs/* is deliberately not built. The scheduler runs in-process and every job is a
# date comparison, so nothing is missed across restarts; a public way to trigger money
# movement behind one shared secret is risk with no matching benefit. `scripts/run_jobs.py`
# covers manual runs.
JOBS_SECRET=

# --- Phase 4: monitoring ---

SENTRY_DSN=
LOG_LEVEL=INFO

# --- Display only; storage is always UTC (CLAUDE.md rule 1) ---

DISPLAY_TIMEZONE=Europe/Kyiv
